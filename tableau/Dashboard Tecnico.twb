      <aliases enabled='yes' />
      <column caption='MunicipioDestacado' datatype='string' name='[Calculation_1730413600972801]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [municipio]  in(&quot;Aguascalientes&quot;, &quot;Jesús María&quot;,&quot;Rincón de Romos&quot;)&#13;&#10;THEN &quot;Municipio destacado&quot;&#13;&#10;ELSE &quot;Otros municipios&quot;&#13;&#10;END' />
      </column>
      <column caption='Top1_Actividad' datatype='string' name='[Calculation_1799410086342659]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [nombre_act] = &quot;Comercio al por menor en tiendas de abarrotes, ultramarinos y misceláneas&quot;&#13;&#10;THEN &quot;Principal&quot;&#13;&#10;ELSE &quot;Otras&quot;&#13;&#10;END' />
      </column>
      <column caption='PorcentajeUEMunicipio' datatype='real' name='[Calculation_1799410437324804]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([id])/{FIXED SUM([id])}' />
      </column>
      <column caption='Porcentaje' datatype='real' name='[Calculation_1799410438897670]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([id]) /&#13;&#10;TOTAL(COUNT([id]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Cálculo1' datatype='real' name='[Calculation_1799410449596427]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([id])/&#13;&#10;total(COUNTD([nombre_act]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Microempresas' datatype='integer' name='[Calculation_1799410452082700]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [per_ocu] = &quot;0 a 5 personas&quot;&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='PorcentajePerOcupado' datatype='real' name='[Calculation_1799410455744527]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1799410452082700])/&#13;&#10;COUNT([__tableau_internal_object_id__].[denue_inegi_01_.csv_0C8EC83C87A0479C98F9082F42E115C5])*100' />
      </column>
      <column caption='totalActividades' datatype='integer' name='[Calculation_1799410466893845]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : COUNTD([nombre_act]) }' />
      </column>
      <column caption='PorcentajeDiversidad' datatype='real' name='[Calculation_1799410469752854]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([nombre_act]) / MIN([Calculation_1799410466893845])' />
      </column>
      <column caption='NivelDiversidad' datatype='string' name='[Calculation_1799410472083480]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1799410469752854] &gt;= 0.60 THEN&#13;&#10;    &quot;Alta&quot;&#13;&#10;ELSEIF [Calculation_1799410469752854] &gt;= 0.30 THEN&#13;&#10;    &quot;Media&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Baja&quot;&#13;&#10;END' />
      </column>
